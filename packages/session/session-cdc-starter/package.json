{
  "name": "@deepseek-ai/dsh-session-cdc-starter",
  "description": "Supervised session CDC composition for Redis cache invalidation and Elasticsearch projection",
  "version": "0.1.0-rc.7",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-cdc-starter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-elasticsearch": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-kafka": "workspace:^",
    "@deepseek-ai/dsh-redis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-kafka-events": "workspace:^",
    "@deepseek-ai/dsh-session-cache-invalidation-redis": "workspace:^",
    "@deepseek-ai/dsh-session-projection-reconciler": "workspace:^",
    "@deepseek-ai/dsh-session-search-projection-elasticsearch": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-elasticsearch": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-kafka": "workspace:^",
    "@deepseek-ai/dsh-redis": "workspace:^"
  }
}
