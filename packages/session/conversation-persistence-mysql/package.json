{
  "name": "@deepseek-ai/dsh-conversation-persistence-mysql",
  "description": "User-scoped message-only conversation and file metadata persistence for MySQL",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/conversation-persistence-mysql"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./runtime-configs": {
      "types": "./lib/types/runtime-configs.d.ts",
      "default": "./lib/runtime-configs.js"
    },
    "./session-persistence": {
      "types": "./lib/types/session-persistence.d.ts",
      "default": "./lib/session-persistence.js"
    },
    "./outbox-consumer": {
      "types": "./lib/types/outbox-consumer.d.ts",
      "default": "./lib/outbox-consumer.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/runtime-configs.js",
    "lib/session-persistence.js",
    "lib/outbox-consumer.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-mysql": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-kafka": "workspace:^",
    "@deepseek-ai/dsh-redis": "workspace:^",
    "@deepseek-ai/dsh-elasticsearch": "workspace:^",
    "@deepseek-ai/dsh-file-storage": "workspace:^",
    "@deepseek-ai/dsh-user": "workspace:^",
    "mysql2": "^3.23.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-mysql": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence": "workspace:^",
    "@deepseek-ai/dsh-kafka": "workspace:^",
    "@deepseek-ai/dsh-redis": "workspace:^",
    "@deepseek-ai/dsh-elasticsearch": "workspace:^",
    "@deepseek-ai/dsh-file-storage": "workspace:^",
    "@deepseek-ai/dsh-user": "workspace:^",
    "mysql2": "^3.23.3"
  }
}
